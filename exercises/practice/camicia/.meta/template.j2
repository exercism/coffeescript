{{ header }}

{{ exercise_name | remove_spaces }} = require './{{ exercise_slug }}'

describe {{ exercise_name | quote }}, ->
{% for case in cases %}
  {{ case["test_keyword"] }} {{ case["description"] | quote }}, ->
    playerA = {{ case["input"]["playerA"] | format_multiline_list(indent=4, columns=10) }}
    playerB = {{ case["input"]["playerB"] | format_multiline_list(indent=4, columns=10) }}
    results = {{ exercise_name | remove_spaces }}.simulateGame playerA, playerB
    expect(results).toEqual {{ case["expected"] | quote }}

{% endfor %}
