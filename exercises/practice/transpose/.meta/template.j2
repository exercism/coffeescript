{{ header }}

{{ exercise_name | remove_spaces }} = require './{{ exercise_slug }}'

describe {{ exercise_name | quote }}, ->
{% for case in cases %}
  {{ case["test_keyword"] }} {{ case["description"] | quote }}, ->
    lines = {{ case["input"]["lines"] | format_multiline_list(indent=4) }}.join "\n"
    expected = {{ case["expected"] | format_multiline_list(indent=4) }}.join "\n"
    expect({{ exercise_name | remove_spaces }}.transpose lines).toEqual expected

{% endfor %}
