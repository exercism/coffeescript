{{ header }}

{ Sublist, Classification } = require './{{ exercise_slug }}'

describe {{ exercise_name | quote }}, ->
{% for case in cases %}
  {{ case["test_keyword"] }} {{ case["description"] | quote }}, ->
    listOne = {{ case["input"]["listOne"] | quote }}
    listTwo = {{ case["input"]["listTwo"] | quote }}
    result = Sublist.classify listOne, listTwo
    expect(result).toEqual Classification.{{ case["expected"] }}

{% endfor %}
