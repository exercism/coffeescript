{{ header }}

{{ exercise_name | remove_spaces }} = require './{{ exercise_slug }}'

describe {{ exercise_name | quote }}, ->
{% for group in groups %}
  describe {{ group["description"] | quote }}, ->
  {% for case in group["cases"] %}
    {{ case["test_keyword"] }} {{ case["description"] | quote }}, ->
      expect({{ exercise_name | remove_spaces }}.{{ case["property"] }} {{ case["input"]["phrase"] | quote }}).toEqual {{ case["expected"] | quote }}

  {% endfor %}
{% endfor %}
