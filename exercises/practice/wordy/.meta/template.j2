{% macro assertion(case) -%}
problem = new {{ exercise_name | remove_spaces }} {{ case["input"]["question"] | quote }}{{ "\n" -}}
{%- if case["expect_error"] -%}
{%- if case["expected"]["error"] == "unknown operation" -%}
expect(-> problem.answer()).toThrow problem.ERROR.unknownOperation
{%- else -%}
expect(-> problem.answer()).toThrow problem.ERROR.syntaxError
{%- endif -%}
{%- else -%}
expect(problem.answer()).toEqual {{ case["expected"] | quote }}
{%- endif -%}
{%- endmacro %}
