{% macro assertion(case) -%}
{%- if case["expect_error"] -%}
expect(-> {{ exercise_name | remove_spaces }}.steps {{ case["input"]["number"] | quote }}).toThrow new Error {{ case["expect_error_msg"] | quote }}
{%- else -%}
expect({{ exercise_name | remove_spaces }}.steps {{ case["input"]["number"] | quote }}).toEqual {{ case["expected"] | quote }}
{%- endif -%}
{%- endmacro %}
{{ header }}

{{ exercise_name | remove_spaces }} = require './{{ exercise_slug }}'

describe {{ exercise_name | quote }}, ->
{% for case in cases %}
  {{ case["test_keyword"] }} {{ case["description"] | quote }}, ->
{{ assertion(case) | indent(4, true) }}

{% endfor %}
