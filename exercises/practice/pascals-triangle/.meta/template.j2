{{ header }}

PascalsTriangle = require './{{ exercise_slug }}'

describe {{ exercise_name | quote }}, ->
{% for case in cases %}
  {{ case["test_keyword"] }} {{ case["description"] | quote }}, ->
    triangle = new PascalsTriangle
    expected = {{ case["expected"] | format_multiline_list(indent=4) }}
    expect(triangle.rows {{ case["input"]["count"] | quote }}).toEqual expected

{% endfor %}
