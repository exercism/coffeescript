{{ header }}

{{ exercise_name | remove_spaces }} = require './{{ exercise_slug }}'

describe {{ exercise_name | quote }}, ->
{% for group in groups %}
  describe {{ group["description"] | quote }}, ->
  {% for subgroup in group["groups"] %}
    describe {{ subgroup["description"] | quote }}, ->
    {% for case in subgroup["cases"] %}
      {{ case["test_keyword"] }} {{ case["description"] | quote }}, ->
        beer = new {{ exercise_name | remove_spaces }}
        expected = {{ case["expected"] | format_multiline_list(indent=8) }}
        {% if case["input"]["takeDown"] == 1 %}
        expect(beer.verse {{ case["input"]["startBottles"] | quote }}).toEqual expected.filter((line) -> line).join " "
        {% else %}
        expect(beer.sing {{ case["input"]["startBottles"] | quote }}, {{ case["input"]["startBottles"] - case["input"]["takeDown"] + 1 }}).toEqual expected.filter((line) -> line).join " "
        {% endif %}

    {% endfor %}
  {% endfor %}
{% endfor %}
